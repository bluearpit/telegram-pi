# Get your token from BotFather. Do not commit your real .env.
TELEGRAM_BOT_TOKEN=replace-me
# Comma-separated Telegram numeric user IDs (never usernames).
TELEGRAM_ALLOWED_USERS=123456789
# Optional absolute directory to use for new Pi sessions.
PI_DEFAULT_CWD=/path/to/project
# Optional; searches Pi transcripts via agentrecall >= 0.2.4 when installed.
# AGENTRECALL_BIN=agentrecall
